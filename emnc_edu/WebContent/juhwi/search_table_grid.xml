function fn_popup(){
    var width = window.innerWidth;
    var height = window.innerHeight;

    var w = Math.min(1000, Math.max(320, width * 0.8));
    var h = Math.min(1000, Math.max(400, height * 0.8));

    var t = Math.max(0, (height - h)/2);
    var l = Math.max(0, (width - w)/2);

    // 팝업 생성 옵션 설정
    let dataObject = {
        type: "json",
        name: "paramData",
        data: { "EMP_CD": "EMP001" }
    };

    let options = {
        id: "popup1",
        type: "wframePopup",
        width: w + "px",
        height: "450px",
        // height: h + "px",
        top: t + "px",
        left: l + "px",
        popupName: "관련자인명조회",
        modal: true,
        resizable: true,
        // closeAction : "scwin.popup_closeAction", // [선택] 팝업의 닫기 버튼을 클릭했을 때 실행할 함수명
        dataObject: dataObject
    };

    // 팝업 생성
    $p.openPopup("/juhwi/EMP_POPUP.xml", options);

    // 팝업 창에서 전달받은 데이터 확인
    // let paramDt = $p.getParameter("paramData");
}









