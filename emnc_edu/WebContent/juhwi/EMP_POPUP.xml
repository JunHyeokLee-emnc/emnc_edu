/**
 * 데이터 클린 함수
 */
function fn_removeAll(){
    console.log("초기화 버튼 클릭");
    dataListPersonal.removeAll();
}
/**
 * 직원 검색
 */
function fn_loadEmp(){
    $p.executeSubmission("submission2");
}

/**
 * 초기화 버튼
 */
scwin.btn_clear_onclick = function (e) {
	fn_removeAll();
};

scwin.btn_search_onclick = function (e) {
    fn_removeAll();
    fn_loadEmp();
};

/**
 * 행 추가
 */
function addRow(dataList){
    dataList.insertRow(0);
}

/**
 * 행 삭제
 */
function deleteRow(dataList){
    var rowCount = dataList.getRowCount();
    var deleteCount = 0;
    for(var i = rowCount - 1; i >= 0; i--){
        var chkYn = dataList.getCellData(i, "CHK_YN");
        if(chkYn){
            dataList.removeRow(i);
            deleteCount++;
        }
    }
    if(deleteCount == 0){
        var idx = dataList.getRowPosition();
        if(idx != null || idx != undefined){
            dataList.removeRow(idx);
            deleteCount++;
        }
    }
    if(deleteCount == 0){
        alert("삭제할 행이 없습니다.");
    }else{
        alert(deleteCount + "건이 삭제되었습니다.");
    }
}

/**
 * 액셀 다운로드
 */
function excelDownload(gridView){
    var excelOpt = {};  // 엑셀 다운로드 옵션
    excelOpt.fileName = "excelEduData.xls"; 
    gridView.advancedExcelDownload(excelOpt);
}
/**
 * 액셀 업로드
 */
function excelUpload(gridView){
    var excelOpt = {};
    excelOpt.startRowIndex = 1;
    excelUpload(excelOpt, excelOpt);
}



// 학력
function excelUpload(gridView, excelOpt){
    // var excelOpt = {};  // 엑셀 다운로드 옵션
    gridView.advancedExcelUpload(excelOpt);
}

scwin.btn_educationAdd_onclick = function (e) {
    addRow(dataListPersonal);
};
scwin.btn_educationDelete_onclick = function (e) {
    deleteRow(dataListPersonal);
};
scwin.btn_educationDownload_onclick = function (e) {
    excelDownload(gridView1);
};
scwin.btn_educationUpload_onclick = function (e) {
    excelUpload(gridView1);
};


scwin.gridView1_oncelldblclick = function (rowIndex, columnIndex, columnId) {
    fn_selectAndClose();
};

/**
 * 선택 후 종료
 */
function fn_selectAndClose(){
    var rowPos = dataListPersonal.getRowPosition();
    $p.parent().scwin.popup_closeAction(dataListPersonal.getCellData(rowPos, "EMP_CD"));
    $p.closePopup();
}
scwin.btn_close_onclick = function () {
    fn_selectAndClose();
};

scwin.btn_selectAndClose_onclick = function () {
	fn_selectAndClose();
};
]]></script>
