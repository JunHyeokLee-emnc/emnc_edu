		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    
};

scwin.contractList = [
    {
        no: "1",
        contractNo: "C2026001",
        division: "신규",
        contractNm: "A사 공급계약",
        projectNm: "ERP 구축 프로젝트",
        startDate: "2026-01-01",
        endDate: "2026-12-31"
    },
    {
        no: "2",
        contractNo: "C2026002",
        division: "변경",
        contractNm: "B사 유지보수계약",
        projectNm: "시스템 유지보수",
        startDate: "2026-02-01",
        endDate: "2026-11-30"
    },
    {
        no: "3",
        contractNo: "C2026003",
        division: "신규",
        contractNm: "C사 개발계약",
        projectNm: "차세대 시스템",
        startDate: "2026-03-01",
        endDate: "2026-12-31"
    },
    {
        no: "4",
        contractNo: "C2026004",
        division: "연장",
        contractNm: "A사 유지보수계약",
        projectNm: "ERP 유지보수",
        startDate: "2026-04-01",
        endDate: "2027-03-31"
    },
    {
        no: "5",
        contractNo: "C2026005",
        division: "신규",
        contractNm: "D사 공급계약",
        projectNm: "물류 시스템",
        startDate: "2026-05-01",
        endDate: "2026-12-31"
    }
];


scwin.btn_search_onclick = function () {
    // 검색어 가져오기
    var searchNm = inp_contractNm. getValue();

    // JSON 데이터 검색
    var result = scwin.contractList.filter(function(item) {

        // 검색어가 없으면 전체 조회
        if (!searchNm) {
            return true;
        }

        // 계약명 포함 여부 확인
        return item.contractNm.indexOf(searchNm) > -1;

    });
    // DataList에 결과 바인딩
    dc_contract.setJSON(scwin.contractList);
    
};

scwin.rdo_division_onchange = function () {
    var division = $p.getComponentById("rdo_division").getValue();

    var result = scwin.contractList.filter(function(item) {

        if (!division || division === "ALL") {
            return true;
        }

        return item.division === division;
    });

    var dc = $p.getComponentById("dc_contract");
    dc.setJSON(result);
};
]]></script>
